{
  "name": "e-clone",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:backend": "pnpm --filter @e-clone/backend dev",
    "dev:frontend": "pnpm --filter @e-clone/frontend dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @e-clone/backend prisma:generate",
    "db:migrate": "pnpm --filter @e-clone/backend prisma:migrate",
    "db:seed": "pnpm --filter @e-clone/backend prisma:seed"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  },
  "packageManager": "pnpm@9.0.0"
}
